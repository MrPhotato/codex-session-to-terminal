; Build only through Build-Installer.ps1, which supplies a reviewed file list.
#ifndef AppVersion
  #error AppVersion is required
#endif
#ifndef PayloadRoot
  #error PayloadRoot is required
#endif
#ifndef PayloadFilesInclude
  #error PayloadFilesInclude is required
#endif
#ifndef BuildOutput
  #error BuildOutput is required
#endif

[Setup]
AppId={{47CC0037-E859-49AB-A98E-D5251553C264}
AppName=Codex Session to Terminal
AppVersion={#AppVersion}
AppPublisher=MrPhotato
AppPublisherURL=https://github.com/MrPhotato/codex-session-to-terminal
AppSupportURL=https://github.com/MrPhotato/codex-session-to-terminal/issues
DefaultDirName={localappdata}\Programs\Codex Session to Terminal
DefaultGroupName=Codex Session to Terminal
DisableDirPage=yes
DisableProgramGroupPage=yes
UsePreviousAppDir=no
PrivilegesRequired=lowest
ArchitecturesAllowed=x64os
ArchitecturesInstallIn64BitMode=x64os
MinVersion=10.0.17763
CloseApplications=no
RestartApplications=no
AlwaysRestart=no
UninstallRestartComputer=no
CreateUninstallRegKey=yes
UninstallDisplayName=Codex Session to Terminal
UninstallDisplayIcon={app}\assets\icon.ico
SetupIconFile={#PayloadRoot}\assets\icon.ico
LicenseFile={#PayloadRoot}\LICENSE
OutputDir={#BuildOutput}
OutputBaseFilename=Codex-Session-to-Terminal-{#AppVersion}-windows-x64-setup
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
VersionInfoVersion=0.2.0.0

[Tasks]
Name: "desktopicon"; Description: "Create a desktop shortcut"; Flags: unchecked; Check: DesktopShortcutAvailable

[Files]
#include PayloadFilesInclude
Source: "{#PayloadRoot}\runtime\*"; DestDir: "{app}\runtime"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{userprograms}\Codex Session to Terminal\Codex Session to Terminal"; Filename: "{app}\Start-CST.cmd"; WorkingDir: "{app}"; IconFilename: "{app}\assets\icon.ico"; Check: StartMenuShortcutAvailable
Name: "{userdesktop}\Codex Session to Terminal"; Filename: "{app}\Start-CST.cmd"; WorkingDir: "{app}"; IconFilename: "{app}\assets\icon.ico"; Check: ShouldCreateDesktopShortcut

; Only dependencies generated by this installation are removed. The install
; directory is fixed and reparse points are rejected before this is reached.
; SessionBridge private state lives outside {app} and is deliberately retained.
[UninstallDelete]
Type: filesandordirs; Name: "{app}\node_modules"

[Code]
const
  AttributeReparsePoint = $400;
  FileOpenReadWrite = 2;
  FileShareExclusive = $10;

var
  HadProductDesktopShortcut: Boolean;

function GetFileAttributesW(FileName: String): Cardinal;
  external 'GetFileAttributesW@kernel32.dll stdcall';

function IsProductShortcut(const Path: String): Boolean;
var
  Shell, Shortcut: Variant;
  Target, EntryName, Directory: String;
  Manifest: AnsiString;
begin
  Result := False;
  if not FileExists(Path) then Exit;
  try
    Shell := CreateOleObject('WScript.Shell');
    Shortcut := Shell.CreateShortcut(Path);
    { A customized command line is not ours to replace. Never execute the target. }
    if Trim(Shortcut.Arguments) <> '' then Exit;
    Target := Shortcut.TargetPath;
    EntryName := Lowercase(ExtractFileName(Target));
    if (EntryName <> 'start-cst.cmd') and (EntryName <> 'start.cmd') and
       (EntryName <> 'enable-normal-desktop.cmd') then Exit;
    Directory := ExtractFileDir(Target);
    if not FileExists(Target) or not FileExists(Directory + '\Start-Flow.ps1') or
       not FileExists(Directory + '\Dependencies.ps1') then Exit;
    if not LoadStringFromFile(Directory + '\package.json', Manifest) then Exit;
    Result := (Pos('"codex-session-to-terminal"', Manifest) > 0) or
      (Pos('"codex-shared-session-lab"', Manifest) > 0);
  except
    Log('Keeping unreadable or unrecognized shortcut: ' + Path);
  end;
end;

function DesktopShortcutAvailable: Boolean;
begin
  Result := not FileExists(ExpandConstant('{userdesktop}\Codex Session to Terminal.lnk'));
end;

function ShouldCreateDesktopShortcut: Boolean;
var
  Path: String;
begin
  Path := ExpandConstant('{userdesktop}\Codex Session to Terminal.lnk');
  Result := IsProductShortcut(Path) or
    (not FileExists(Path) and (HadProductDesktopShortcut or WizardIsTaskSelected('desktopicon')));
end;

function StartMenuShortcutAvailable: Boolean;
var
  Path: String;
begin
  Path := ExpandConstant('{userprograms}\Codex Session to Terminal\Codex Session to Terminal.lnk');
  Result := not FileExists(Path) or IsProductShortcut(Path);
end;

procedure PreserveProductShortcut(const Path, BackupPath: String; RemoveOld: Boolean);
begin
  if not IsProductShortcut(Path) then Exit;
  if not ForceDirectories(ExtractFileDir(BackupPath)) or
     not FileCopy(Path, BackupPath, True) then
    RaiseException('Could not back up the existing shortcut: ' + Path);
  if RemoveOld and not DeleteFile(Path) then
    RaiseException('Could not remove the retired product shortcut: ' + Path);
end;

procedure ConsolidateShortcuts;
var
  BackupRoot, DesktopRoot, StartMenuRoot: String;
begin
  BackupRoot := ExpandConstant('{localappdata}\SessionBridge\shortcut-backups\') +
    GetDateTimeString('yyyymmdd-hhnnss-zzz', '-', ':');
  DesktopRoot := ExpandConstant('{userdesktop}\');
  StartMenuRoot := ExpandConstant('{userprograms}\Codex Session to Terminal\');
  { Remember an existing product desktop entry before its retired alias is
    removed. Its replacement must not depend on the optional new-icon task. }
  HadProductDesktopShortcut :=
    IsProductShortcut(DesktopRoot + 'Codex Session to Terminal.lnk') or
    IsProductShortcut(DesktopRoot + 'Codex Session to Terminal - Independent.lnk') or
    IsProductShortcut(DesktopRoot + 'Codex Session to Terminal - Legacy Shared Startup.lnk');
  { Back up recognized shortcuts before standard entries are replaced. Unknown
    targets, customized arguments and other applications are kept unchanged. }
  PreserveProductShortcut(DesktopRoot + 'Codex Session to Terminal.lnk',
    BackupRoot + '\Desktop-standard.lnk', False);
  PreserveProductShortcut(StartMenuRoot + 'Codex Session to Terminal.lnk',
    BackupRoot + '\StartMenu-standard.lnk', False);
  PreserveProductShortcut(DesktopRoot + 'Codex Session to Terminal - Independent.lnk',
    BackupRoot + '\Desktop-independent.lnk', True);
  PreserveProductShortcut(DesktopRoot + 'Codex Session to Terminal - Legacy Shared Startup.lnk',
    BackupRoot + '\Desktop-legacy.lnk', True);
  PreserveProductShortcut(StartMenuRoot + 'Codex Session to Terminal - Independent.lnk',
    BackupRoot + '\StartMenu-independent.lnk', True);
  PreserveProductShortcut(StartMenuRoot + 'Codex Session to Terminal - Legacy Shared Startup.lnk',
    BackupRoot + '\StartMenu-legacy.lnk', True);
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssInstall then ConsolidateShortcuts;
end;

function IsReparsePoint(const Path: String): Boolean;
var
  Attributes: Cardinal;
begin
  Attributes := GetFileAttributesW(Path);
  Result := (Attributes <> $FFFFFFFF) and ((Attributes and AttributeReparsePoint) <> 0);
end;

function FindUnavailableFile(const Directory: String): String;
var
  FindRec: TFindRec;
  Path, Extension: String;
  Stream: TFileStream;
begin
  Result := '';
  if IsReparsePoint(Directory) then begin
    Result := Directory + ' (directory link)';
    Exit;
  end;
  if not DirExists(Directory) then Exit;
  if FindFirst(AddBackslash(Directory) + '*', FindRec) then begin
    try
      repeat
        if (FindRec.Name <> '.') and (FindRec.Name <> '..') then begin
          Path := AddBackslash(Directory) + FindRec.Name;
          if (FindRec.Attributes and AttributeReparsePoint) <> 0 then begin
            Result := Path + ' (file or directory link)';
          end else if (FindRec.Attributes and FILE_ATTRIBUTE_DIRECTORY) <> 0 then begin
            Result := FindUnavailableFile(Path);
          end else begin
            Extension := Lowercase(ExtractFileExt(Path));
            if (Extension = '.exe') or (Extension = '.dll') then begin
              { Opening with exclusive read/write access detects loaded images
                and ordinary file locks. No bytes are written. Fail closed on
                access errors; never close or terminate the owning process. }
              try
                Stream := TFileStream.Create(Path, FileOpenReadWrite or FileShareExclusive);
                Stream.Free;
              except
                Result := Path;
              end;
            end;
          end;
          if Result <> '' then Exit;
        end;
      until not FindNext(FindRec);
    finally
      FindClose(FindRec);
    end;
  end;
end;

function CheckInstallFiles: String;
var
  AppDirectory, ExpectedDirectory, Unavailable: String;
begin
  Result := '';
  AppDirectory := RemoveBackslashUnlessRoot(ExpandConstant('{app}'));
  ExpectedDirectory := ExpandConstant('{localappdata}\Programs\Codex Session to Terminal');
  if CompareText(AppDirectory, ExpectedDirectory) <> 0 then begin
    Result := 'This installer only supports its fixed current-user installation directory.';
    Exit;
  end;
  if IsReparsePoint(ExpandConstant('{localappdata}\Programs')) or IsReparsePoint(AppDirectory) then begin
    Result := 'The installation directory must not be a file-system link. No files were changed.';
    Exit;
  end;
  Unavailable := FindUnavailableFile(AppDirectory + '\runtime');
  if Unavailable = '' then Unavailable := FindUnavailableFile(AppDirectory + '\node_modules');
  if Unavailable = '' then Unavailable := FindUnavailableFile(AppDirectory + '\bin');
  if Unavailable <> '' then
    Result := 'Installation files are in use, inaccessible, or linked to another location.' + #13#10 +
      'Exit the side terminals and the ChatGPT session using this installation, then try again.' + #13#10 +
      'Setup will not close any application. Private data will be kept.' + #13#10#13#10 + Unavailable;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  Result := CheckInstallFiles;
end;

function InitializeUninstall: Boolean;
var
  Problem: String;
begin
  Problem := CheckInstallFiles;
  Result := Problem = '';
  if not Result then SuppressibleMsgBox(Problem, mbError, MB_OK, IDOK);
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  Problem: String;
begin
  if CurUninstallStep = usUninstall then begin
    Problem := CheckInstallFiles;
    if Problem <> '' then RaiseException(Problem);
  end;
end;

function UpdateReadyMemo(Space, NewLine, MemoUserInfoInfo, MemoDirInfoInfo, MemoTypeInfo,
  MemoComponentsInfo, MemoGroupInfo, MemoTasksInfo: String): String;
begin
  Result := MemoDirInfoInfo + NewLine + MemoTasksInfo + NewLine +
    'Installation does not start ChatGPT or change its settings.' + NewLine +
    'Open Codex Session to Terminal after starting Desktop normally.';
  if IsProductShortcut(ExpandConstant('{userdesktop}\Codex Session to Terminal.lnk')) then
    Result := Result + NewLine + 'The existing product shortcut will be updated. Retired product shortcuts will be backed up and removed.'
  else if not DesktopShortcutAvailable then
    Result := Result + NewLine + 'The existing custom desktop shortcut will be kept unchanged.';
end;
