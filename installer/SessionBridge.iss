; Build only through Build-Installer.ps1, which supplies a reviewed file list.
#ifndef AppVersion
  #error AppVersion is required
#endif
#ifndef PayloadRoot
  #error PayloadRoot is required
#endif
#ifndef PayloadFilesInclude
  #error PayloadFilesInclude is required
#endif
#ifndef BuildOutput
  #error BuildOutput is required
#endif

[Setup]
AppId={{47CC0037-E859-49AB-A98E-D5251553C264}
AppName=Codex Session to Terminal
AppVersion={#AppVersion}
AppPublisher=MrPhotato
AppPublisherURL=https://github.com/MrPhotato/codex-session-to-terminal
AppSupportURL=https://github.com/MrPhotato/codex-session-to-terminal/issues
DefaultDirName={localappdata}\Programs\Codex Session to Terminal
DefaultGroupName=Codex Session to Terminal
DisableDirPage=yes
DisableProgramGroupPage=yes
UsePreviousAppDir=no
PrivilegesRequired=lowest
ArchitecturesAllowed=x64os
ArchitecturesInstallIn64BitMode=x64os
MinVersion=10.0.17763
CloseApplications=no
RestartApplications=no
AlwaysRestart=no
UninstallRestartComputer=no
CreateUninstallRegKey=yes
UninstallDisplayName=Codex Session to Terminal
UninstallDisplayIcon={app}\assets\icon.ico
SetupIconFile={#PayloadRoot}\assets\icon.ico
LicenseFile={#PayloadRoot}\LICENSE
OutputDir={#BuildOutput}
OutputBaseFilename=Codex-Session-to-Terminal-{#AppVersion}-windows-x64-setup
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
VersionInfoVersion=0.2.0.0

[Tasks]
Name: "desktopicon"; Description: "Create a desktop shortcut (existing shortcuts are kept)"; Flags: unchecked; Check: DesktopShortcutAvailable

[Files]
#include PayloadFilesInclude
Source: "{#PayloadRoot}\runtime\*"; DestDir: "{app}\runtime"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{userprograms}\Codex Session to Terminal\Codex Session to Terminal"; Filename: "{app}\Start-CST.cmd"; WorkingDir: "{app}"; IconFilename: "{app}\assets\icon.ico"; Check: StartMenuShortcutAvailable
Name: "{userdesktop}\Codex Session to Terminal"; Filename: "{app}\Start-CST.cmd"; WorkingDir: "{app}"; IconFilename: "{app}\assets\icon.ico"; Tasks: desktopicon; Check: DesktopShortcutAvailable
Name: "{userprograms}\Codex Session to Terminal\CST - Independent"; Filename: "{app}\Start-CST.cmd"; WorkingDir: "{app}"; IconFilename: "{app}\assets\icon.ico"
Name: "{userprograms}\Codex Session to Terminal\CST - Legacy Shared Startup"; Filename: "{app}\Start.cmd"; WorkingDir: "{app}"; IconFilename: "{app}\assets\icon.ico"

; Only dependencies generated by this installation are removed. The install
; directory is fixed and reparse points are rejected before this is reached.
; SessionBridge private state lives outside {app} and is deliberately retained.
[UninstallDelete]
Type: filesandordirs; Name: "{app}\node_modules"

[Code]
const
  AttributeReparsePoint = $400;
  FileOpenReadWrite = 2;
  FileShareExclusive = $10;

function GetFileAttributesW(FileName: String): Cardinal;
  external 'GetFileAttributesW@kernel32.dll stdcall';

function DesktopShortcutAvailable: Boolean;
begin
  Result := not FileExists(ExpandConstant('{userdesktop}\Codex Session to Terminal.lnk'));
end;

function StartMenuShortcutAvailable: Boolean;
begin
  Result := not FileExists(ExpandConstant('{userprograms}\Codex Session to Terminal\Codex Session to Terminal.lnk'));
end;

function IsReparsePoint(const Path: String): Boolean;
var
  Attributes: Cardinal;
begin
  Attributes := GetFileAttributesW(Path);
  Result := (Attributes <> $FFFFFFFF) and ((Attributes and AttributeReparsePoint) <> 0);
end;

function FindUnavailableFile(const Directory: String): String;
var
  FindRec: TFindRec;
  Path, Extension: String;
  Stream: TFileStream;
begin
  Result := '';
  if IsReparsePoint(Directory) then begin
    Result := Directory + ' (directory link)';
    Exit;
  end;
  if not DirExists(Directory) then Exit;
  if FindFirst(AddBackslash(Directory) + '*', FindRec) then begin
    try
      repeat
        if (FindRec.Name <> '.') and (FindRec.Name <> '..') then begin
          Path := AddBackslash(Directory) + FindRec.Name;
          if (FindRec.Attributes and AttributeReparsePoint) <> 0 then begin
            Result := Path + ' (file or directory link)';
          end else if (FindRec.Attributes and FILE_ATTRIBUTE_DIRECTORY) <> 0 then begin
            Result := FindUnavailableFile(Path);
          end else begin
            Extension := Lowercase(ExtractFileExt(Path));
            if (Extension = '.exe') or (Extension = '.dll') then begin
              { Opening with exclusive read/write access detects loaded images
                and ordinary file locks. No bytes are written. Fail closed on
                access errors; never close or terminate the owning process. }
              try
                Stream := TFileStream.Create(Path, FileOpenReadWrite or FileShareExclusive);
                Stream.Free;
              except
                Result := Path;
              end;
            end;
          end;
          if Result <> '' then Exit;
        end;
      until not FindNext(FindRec);
    finally
      FindClose(FindRec);
    end;
  end;
end;

function CheckInstallFiles: String;
var
  AppDirectory, ExpectedDirectory, Unavailable: String;
begin
  Result := '';
  AppDirectory := RemoveBackslashUnlessRoot(ExpandConstant('{app}'));
  ExpectedDirectory := ExpandConstant('{localappdata}\Programs\Codex Session to Terminal');
  if CompareText(AppDirectory, ExpectedDirectory) <> 0 then begin
    Result := 'This installer only supports its fixed current-user installation directory.';
    Exit;
  end;
  if IsReparsePoint(ExpandConstant('{localappdata}\Programs')) or IsReparsePoint(AppDirectory) then begin
    Result := 'The installation directory must not be a file-system link. No files were changed.';
    Exit;
  end;
  Unavailable := FindUnavailableFile(AppDirectory + '\runtime');
  if Unavailable = '' then Unavailable := FindUnavailableFile(AppDirectory + '\node_modules');
  if Unavailable = '' then Unavailable := FindUnavailableFile(AppDirectory + '\bin');
  if Unavailable <> '' then
    Result := 'Installation files are in use, inaccessible, or linked to another location.' + #13#10 +
      'Exit the side terminals and the ChatGPT session using this installation, then try again.' + #13#10 +
      'Setup will not close any application. Private data will be kept.' + #13#10#13#10 + Unavailable;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  Result := CheckInstallFiles;
end;

function InitializeUninstall: Boolean;
var
  Problem: String;
begin
  Problem := CheckInstallFiles;
  Result := Problem = '';
  if not Result then SuppressibleMsgBox(Problem, mbError, MB_OK, IDOK);
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  Problem: String;
begin
  if CurUninstallStep = usUninstall then begin
    Problem := CheckInstallFiles;
    if Problem <> '' then RaiseException(Problem);
  end;
end;

function UpdateReadyMemo(Space, NewLine, MemoUserInfoInfo, MemoDirInfoInfo, MemoTypeInfo,
  MemoComponentsInfo, MemoGroupInfo, MemoTasksInfo: String): String;
begin
  Result := MemoDirInfoInfo + NewLine + MemoTasksInfo + NewLine +
    'Installation does not start ChatGPT or change its settings.' + NewLine +
    'Independent mode attaches to an already running Desktop. The legacy shared-startup entry remains available.';
  if not DesktopShortcutAvailable then
    Result := Result + NewLine + 'The existing desktop shortcut will be kept unchanged.';
end;
